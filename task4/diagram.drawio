        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart LR\n    classDef ext fill:#fce7f3,stroke:#9d174d,stroke-width:2px;\n    classDef proc fill:#dbeafe,stroke:#1e40af,stroke-width:2px;\n    classDef store fill:#fef3c7,stroke:#b45309,stroke-width:2px;\n    classDef portal fill:#dcfce7,stroke:#15803d,stroke-width:2px;\n\n    PAT([\&quot;Пациенты\&quot;]):::ext\n    DOC([\&quot;Врачи\&quot;]):::ext\n    CLI([\&quot;Клиенты банка\&quot;]):::ext\n    USR([\&quot;Бизнес-пользователи и менеджмент\&quot;]):::ext\n    REG([\&quot;Регуляторы\&quot;]):::ext\n    PH([\&quot;Фармкомпании (будущее)\&quot;]):::ext\n    EL([\&quot;Медэлектроника (будущее)\&quot;]):::ext\n\n    subgraph CLIN[\&quot;Домен «Клиники»\&quot;]\n        P11((\&quot;1.1 МИС: приёмы и лечение\&quot;)):::proc\n        S1[(\&quot;Хранилище медданных (медкарты, шифрование)\&quot;)]:::store\n        P12((\&quot;1.2 Анонимизация\&quot;)):::proc\n    end\n\n    subgraph AID[\&quot;Домен «ИИ-сервисы»\&quot;]\n        P21((\&quot;2.1 Обучение моделей\&quot;)):::proc\n        S2[(\&quot;Хранилище признаков (анонимизированные данные)\&quot;)]:::store\n        P22((\&quot;2.2 Инференс: поддержка диагноза\&quot;)):::proc\n    end\n\n    subgraph FIN[\&quot;Домен «Финтех» (банк)\&quot;]\n        P31((\&quot;3.1 Финтех-сервисы: счета, кредиты, платежи\&quot;)):::proc\n        S3[(\&quot;Банковская БД\&quot;)]:::store\n        P32((\&quot;3.2 Риски и антифрод\&quot;)):::proc\n    end\n\n    subgraph HQ[\&quot;Домен «Головной офис»\&quot;]\n        P41((\&quot;4.1 ERP / HR / Инвентаризация\&quot;)):::proc\n        P42((\&quot;4.2 Консолидированная отчётность\&quot;)):::proc\n    end\n\n    subgraph PART[\&quot;Домен «Партнёрская экосистема» (будущее)\&quot;]\n        P51((\&quot;5.1 Стандартный партнёрский коннектор\&quot;)):::proc\n    end\n\n    subgraph PLAT[\&quot;Общая платформа данных (без бизнес-логики)\&quot;]\n        GW((\&quot;API-шлюз\&quot;)):::proc\n        BUS((\&quot;Шина данных Kafka: события и CDC\&quot;)):::proc\n        S6[(\&quot;Озеро данных Bronze\&quot;)]:::store\n        P62((\&quot;6.2 Трансформации Silver\&quot;)):::proc\n        S7[(\&quot;Доменные витрины Gold\&quot;)]:::store\n        P63((\&quot;6.3 Семантический слой: метрики\&quot;)):::proc\n        P71((\&quot;7.1 Портал самообслуживания «витрина данных»\&quot;)):::portal\n        S8[(\&quot;Каталог данных + IAM (RBAC/ABAC)\&quot;)]:::store\n    end\n\n    DOC --&gt;|\&quot;данные приёмов\&quot;| P11\n    PAT --&gt;|\&quot;согласия, мастер-данные\&quot;| P11\n    P11 &lt;--&gt;|\&quot;чтение/запись\&quot;| S1\n    S1 --&gt;|\&quot;медданные\&quot;| P12\n    P12 --&gt;|\&quot;анонимизированные события (без врачебной тайны)\&quot;| BUS\n\n    CLI --&gt;|\&quot;платежи, кредитные заявки\&quot;| P31\n    P31 &lt;--&gt;|\&quot;чтение/запись\&quot;| S3\n    S3 --&gt;|\&quot;финансовые события, CDC\&quot;| BUS\n    S3 --&gt;|\&quot;транзакции\&quot;| P32\n    P32 --&gt;|\&quot;оценка риска\&quot;| P31\n\n    P41 --&gt;|\&quot;HR, инвентаризация, финотчётность\&quot;| BUS\n\n    PH --&gt;|\&quot;НСИ препаратов, продажи\&quot;| P51\n    EL --&gt;|\&quot;телеметрия устройств\&quot;| P51\n    P51 --&gt;|\&quot;события в стандартном формате\&quot;| BUS\n\n    BUS --&gt;|\&quot;сырые данные\&quot;| S6\n    S6 --&gt; P62\n    P62 --&gt;|\&quot;курируемые данные\&quot;| S7\n    S7 --&gt; P63\n    P63 --&gt;|\&quot;метрики\&quot;| P71\n    USR --&gt;|\&quot;запрос отчётов в пределах доступа\&quot;| P71\n    S8 -.-&gt;|\&quot;авторизация, маскирование, аудит\&quot;| P71\n    P62 -.-&gt;|\&quot;lineage, качество данных\&quot;| S8\n\n    S6 --&gt;|\&quot;анонимизированные данные для ИИ\&quot;| P21\n    P21 --&gt; S2\n    S2 --&gt; P22\n    P22 --&gt;|\&quot;результаты инференса\&quot;| GW\n    GW --&gt;|\&quot;ИИ-поддержка диагноза\&quot;| P11\n\n    P31 &lt;--&gt;|\&quot;API-контракты, напр. «кредит на лечение»\&quot;| GW\n    GW &lt;--&gt;|\&quot;операционные API\&quot;| P41\n\n    S7 --&gt;|\&quot;витрины для консолидации\&quot;| P42\n    P42 --&gt;|\&quot;регуляторные отчёты\&quot;| REG&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="oGepzP1wyrvSItz7kdB5-1">
