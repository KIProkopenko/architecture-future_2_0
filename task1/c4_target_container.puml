@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Целевая архитектура «Будущее 2.0» через 1 год — уровень контейнеров (C4)

Person(po, "Менеджмент и аналитики головного офиса", "Управленческая и стратегическая отчётность")
Person(pc, "Сотрудники клиник", "Врачи и операторы")
Person(pa, "Специалисты ИИ-компании", "Обучение и эксплуатация ИИ-моделей")
Person(pf, "Сотрудники финтех-компании (банк)", "Продуктовая и финансовая аналитика")

System_Boundary(clinics, "Домен «Клиники»") {
    Container(mis, "МИС — веб-интерфейс клиник", "Веб-приложение, микросервисы", "Замена PowerBuilder: приём, назначения, расписание")
    ContainerDb(meddb, "Медицинская БД", "PostgreSQL, шифрование", "Медкарты, истории болезней — изолированы от аналитики")
    Container(anon, "Сервис анонимизации", "Микросервис", "Деперсонализация данных без врачебной тайны")
}

System_Boundary(fintech, "Домен «Финтех» (банк)") {
    Container(ftsvc, "Финтех-сервисы", "Golang / Java", "Кредиты, счета, платежи")
    ContainerDb(ftdb, "Банковская БД", "PostgreSQL", "Финансовая история, счета, кредиты")
}

System_Boundary(ai, "Домен «ИИ-сервисы»") {
    Container(aisvc, "ИИ-сервисы", "Python, ML-платформа", "Поддержка диагностики и лечения")
    ContainerDb(fstore, "Хранилище признаков", "Векторные/колоночные БД", "Анонимизированные данные")
}

System_Boundary(hq, "Домен «Головной офис»") {
    System_Ext(erp, "ERP / HR / Инвентаризация", "Учётные системы головного офиса")
}

System_Boundary(platform, "Единая облачная платформа данных") {
    Container(gw, "API-шлюз", "API Gateway", "Синхронная интеграция доменов по контрактам")
    ContainerQueue(bus, "Шина данных", "Apache Kafka", "События и CDC, замена легаси-ESB")
    ContainerDb(lake, "Озеро данных (Bronze)", "Объектное хранилище", "Сырые данные, сотни ТБ")
    ContainerDb(dwh, "Хранилище-витрины (Silver/Gold)", "MPP: Greenplum / ClickHouse", "Доменные витрины, отчёты за минуты")
    Container(sem, "Семантический слой", "Магазин метрик", "Единые бизнес-показатели")
    Container(portal, "Портал самообслуживания («витрина данных»)", "Веб + BI-движок", "Отчёты, конструктор, дашборды")
    Container(cat, "Каталог данных и качество", "Метедата-сервис", "Поиск датасетов, lineage")
    Container(iam, "Сервис доступа и безопасности", "IAM, RBAC/ABAC", "Маскирование, аудит, 152-ФЗ, ЦБ РФ")
}

Rel(pc, mis, "Работа с пациентами")
Rel(mis, meddb, "Чтение/запись")
Rel(mis, anon, "Передача данных")
Rel(anon, bus, "Деперсонализированные события", "ИИ/аналитика без врачебной тайны")
Rel(ftsvc, ftdb, "Чтение/запись")
Rel(ftsvc, bus, "События и CDC")
Rel(erp, bus, "Загрузка данных")
Rel(bus, lake, "Приём сырых данных", "Масштабирование и новые бизнесы")
Rel(lake, dwh, "Построение витрин", "Быстрая отчётность")
Rel(dwh, sem, "Публикация метрик")
Rel(sem, portal, "Данные для отчётов")
Rel(po, portal, "Отчёты и конструктор", "Быстрые управленческие решения")
Rel(pf, portal, "Финтех-аналитика", "Независимое развитие финтеха")
Rel(pa, cat, "Поиск датасетов", "Независимое развитие ИИ")
Rel(lake, aisvc, "Анонимизированные данные")
Rel(aisvc, fstore, "Признаки для моделей")
Rel(aisvc, gw, "ИИ-сервисы для МИС")
Rel(iam, portal, "Авторизация, маскирование")
Rel(gw, ftsvc, "API по контрактам", "Подключение новых бизнесов")
Rel(gw, mis, "API по контрактам")
@enduml